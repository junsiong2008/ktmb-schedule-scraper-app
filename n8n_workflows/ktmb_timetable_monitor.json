{
    "name": "KTMB Timetable Monitor (Gemini AI Extractor)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "days"
                        }
                    ]
                }
            },
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "url": "https://www.ktmb.com.my/TrainTime.html",
                "options": {}
            },
            "name": "Fetch KTMB Website",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "operation": "extractHtmlContent",
                "extractionValues": {
                    "values": [
                        {
                            "key": "pageContent",
                            "cssSelector": "body",
                            "returnValue": "html"
                        }
                    ]
                },
                "options": {}
            },
            "name": "HTML Extract",
            "type": "n8n-nodes-base.htmlExtract",
            "typeVersion": 2,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "schemaType": "defineCustom",
                "jsonSchemaString": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"timetables\": {\n      \"type\": \"array\",\n      \"description\": \"List of all train timetables found on the page\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"routeName\": {\n            \"type\": \"string\",\n            \"description\": \"The name of the train route, e.g. 'Batu Caves - Pulau Sebang' or 'North-South Sector Train'\"\n          },\n          \"effectiveDate\": {\n            \"type\": \"string\",\n            \"description\": \"The date the timetable goes into effect, e.g. '13th February 2026'\"\n          },\n          \"pdfUrl\": {\n            \"type\": \"string\",\n            \"description\": \"The URL or path to download the PDF schedule. Combine href and data-dl to find it if needed.\"\n          }\n        }\n      }\n    }\n  }\n}",
                "options": {}
            },
            "name": "AIExtractor",
            "type": "@n8n/n8n-nodes-langchain.chainExtractor",
            "typeVersion": 1,
            "position": [
                620,
                0
            ]
        },
        {
            "parameters": {
                "model": "models/gemini-1.5-flash",
                "options": {}
            },
            "name": "Google Gemini Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                620,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "// Step 1: Normalize AI output\nconst extractedText = $input.first().json.timetables || [];\n\nconst foundLinks = extractedText.map(item => {\n  let url = item.pdfUrl || '';\n  // ensure absolute URL\n  const fullUrl = url.startsWith('http') ? url : `https://www.ktmb.com.my${url.startsWith('/') ? '' : '/'}${url}`;\n  \n  return {\n    url: fullUrl,\n    title: `${item.routeName} - Effective ${item.effectiveDate}`\n  };\n});\n\n// Step 2: State Checking\nconst staticData = $getWorkflowStaticData('global');\n\nconst currentTitles = foundLinks.map(link => link.title).sort().join('|');\nconst lastTitles = staticData.lastSeenTitles || '';\n\nlet hasChanges = false;\nlet newOrUpdatedLinks = [];\n\nif (currentTitles !== lastTitles && currentTitles !== '') {\n  hasChanges = true;\n  \n  const lastTitlesArray = lastTitles.split('|');\n  newOrUpdatedLinks = foundLinks.filter(link => !lastTitlesArray.includes(link.title));\n  \n  // Uncomment the line below to save the state\n  // staticData.lastSeenTitles = currentTitles;\n}\n\nreturn {\n  hasChanges,\n  newOrUpdatedLinks,\n  allCurrentLinks: foundLinks\n};"
            },
            "name": "Check State",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.hasChanges }}",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Has Updates?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                1080,
                0
            ]
        },
        {
            "parameters": {
                "fromEmail": "your-email@example.com",
                "toEmail": "your-email@example.com",
                "subject": "KTMB Timetable Update Detected! (Gemini AI)",
                "html": "=<p>New KTMB Timetable links have been detected by the Gemini Extractor:</p>\n<ul>\n{{ $json.newOrUpdatedLinks.map(link => `<li><a href=\"${link.url}\">${link.title}</a></li>`).join('') }}\n</ul>\n<p>Please check the KTMB website to download the latest PDFs.</p>"
            },
            "name": "Send Email",
            "type": "n8n-nodes-base.emailSend",
            "typeVersion": 2.1,
            "position": [
                1300,
                -100
            ]
        },
        {
            "parameters": {},
            "name": "No Updates (End)",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                1300,
                140
            ]
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "Fetch KTMB Website",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch KTMB Website": {
            "main": [
                [
                    {
                        "node": "HTML Extract",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "HTML Extract": {
            "main": [
                [
                    {
                        "node": "AIExtractor",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "AIExtractor": {
            "main": [
                [
                    {
                        "node": "Check State",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Gemini Chat Model": {
            "ai_languageModel": [
                [
                    {
                        "node": "AIExtractor",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ]
            ]
        },
        "Check State": {
            "main": [
                [
                    {
                        "node": "Has Updates?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Has Updates?": {
            "main": [
                [
                    {
                        "node": "Send Email",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "No Updates (End)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}