# Copy this to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection (same DB as ktmb_api)
DB_USER=your-db-username
DB_HOST=your-db-host-or-ip
DB_NAME=your-db-name
DB_PASSWORD=your-password
DB_PORT=5432

# KTMB GTFS Realtime feed
GTFS_URL=https://api.data.gov.my/gtfs-realtime/vehicle-position/ktmb

# How often to poll in milliseconds (30s recommended)
POLL_INTERVAL_MS=30000
